# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose up -d gives you this one)
DATABASE_URL=postgres://cta:cta@localhost:5432/cta
PORT=3000

# Long random strings: `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-32-chars-min

# Phone numbers that always accept a fixed code and never send an SMS
# (for development and App Store review). Format: +225...:123456,+225...:654321
AUTH_TEST_CODES=+2250700000000:123456

# Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp)
META_APP_SECRET=
META_VERIFY_TOKEN=pick-any-random-string
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# Claude API. Leave empty to use the offline keyword assistant.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5

# Expo push (optional; only needed if you enable push security in Expo)
EXPO_ACCESS_TOKEN=

# Seconds to wait for more customer messages before answering a burst
REPLY_DEBOUNCE_SECONDS=4
